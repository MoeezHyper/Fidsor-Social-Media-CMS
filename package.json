{
  "name": "fidsor-social-media-cms",
  "version": "1.0.0",
  "description": "Fidsor Social Media CMS with Meta Graph API Social Media Publisher",
  "main": "server/index.js",
  "scripts": {
    "prestart": "node scripts/ensure-deps.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client\""
  },
  "keywords": [
    "cms",
    "meta-graph-api",
    "facebook",
    "instagram",
    "social-media-publisher"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
